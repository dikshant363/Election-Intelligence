# Election Intelligence Platform — Environment Configuration
# Copy this file to .env and fill in required values
# NEVER commit .env to git

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="Election Intelligence Platform"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://localhost:5432/election_intelligence
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Replace JWT_SECRET_KEY with a secure random string in production
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","*"]
SECURE_COOKIES=false
TRUSTED_PROXY_COUNT=1
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=30.0
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY="default-src 'self'; frame-ancestors 'none'; object-src 'none';"

# ── AI Providers (optional for development) ───────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# AI_MODEL=gpt-4o
# AI_TEMPERATURE=0.2
# AI_MAX_TOKENS=2048
# AI_TIMEOUT=30.0

# Embeddings
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=election-intelligence-platform

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_PATH=./storage
BACKUP_PATH=./backups