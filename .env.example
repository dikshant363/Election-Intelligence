# ==============================================================================
# Election Intelligence Platform — Environment Configuration Template
# All secrets and external keys must use environment-specific overrides in production.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=3000
ENVIRONMENT=development
RUST_LOG=info,election_intelligence=debug

# Authoritative Database Connection (PostgreSQL 17)
# For local development:
DATABASE_URL=postgres://localhost:5432/election_intelligence
# For Neon / Render / Cloud TLS connections:
# DATABASE_URL=postgres://user:password@ep-sample-pooler.region.aws.neon.tech/election_intelligence?sslmode=require

# Administrative Authorization Token
# Required for write endpoints: /api/v1/etl/ingest, /api/v1/corrections/:id/review, /api/v1/admin/feature-flags
ADMIN_API_KEY=change_me_to_a_secure_random_token_32_chars_min

# Security & Session Token Secret
JWT_SECRET=change_me_to_a_cryptographically_secure_random_key_64_chars_min

# Optional: Grounded AI Engine (Google Gemini API)
# If omitted, platform operates in high-performance deterministic Local Offline Verifier mode.
# GEMINI_API_KEY=your_gemini_api_key_here

# Autopilot Engineering System Configuration
AUTOPILOT_ENABLED=true
# DEPLOYMENT_URL=https://election-intelligence-platform.onrender.com
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-sample123?key=sample456
