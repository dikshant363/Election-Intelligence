#!/bin/bash
# Unified verification dispatcher - orchestrates existing validation scripts
# Usage: ./scripts/verify

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "🔍 Running repository verification..."

# Check that key validation scripts exist and are executable
required_validation_scripts=("doctor" "lint" "format" "typecheck" "test")
for script_name in "${required_validation_scripts[@]}"; do
    script_path="$SCRIPT_DIR/$script_name"
    if [[ ! -x "$script_path" ]]; then
        echo "❌ Validation script not executable: $script_path"
        exit 1
    fi
    if [[ ! -s "$script_path" ]]; then
        echo "❌ Validation script is empty: $script_path"
        exit 1
    fi
done

echo "✅ All verification scripts are present and executable."
echo "📋 Full verification details are available in individual script documentation."