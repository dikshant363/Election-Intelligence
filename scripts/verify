#!/bin/bash
# Unified verification dispatcher - orchestrates existing validation scripts
# Usage: ./scripts/verify

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "🔍 Running repository verification..."

echo "🔧 Running doctor..."
"$SCRIPT_DIR/doctor"

echo "🔧 Running format..."
"$SCRIPT_DIR/format"

echo "🔧 Running lint..."
"$SCRIPT_DIR/lint"

echo "🔧 Running typecheck..."
"$SCRIPT_DIR/typecheck"

echo "🔧 Running test..."
"$SCRIPT_DIR/test"

echo "🔧 Running clean..."
"$SCRIPT_DIR/clean"

echo "✅ Verification complete. Individual scripts provide detailed results."